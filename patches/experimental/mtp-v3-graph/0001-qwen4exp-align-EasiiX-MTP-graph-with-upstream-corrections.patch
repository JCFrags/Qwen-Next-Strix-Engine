From 53a26438bee732b780df6d797f0bfd29cde68df6 Mon Sep 17 00:00:00 2001
From: Home Services Lead <noreply@local.invalid>
Date: Sat, 29 Aug 2026 05:12:25 -0700
Subject: [PATCH] qwen4exp: align EasiiX MTP graph with upstream corrections

Keep the exact EasiiX 34-tensor sidecar layout while applying the relevant graph corrections from upstream llama.cpp PR 27836 commit d72620018f612bb05d16e585108e3440947a1f9f.

Use grouped hidden-state RMS normalization, materialize both nextn exports, omit the narrow MTP embedding export, and expose target hidden rows only when nextn extraction is enabled.
---
 src/models/qwen4exp.cpp | 46 +++++++++++++++++++++++------------------
 1 file changed, 26 insertions(+), 20 deletions(-)

diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 9372675..1240882 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -313,7 +313,9 @@ llama_model_qwen4exp::graph_mtp::graph_mtp(const llama_model & model, const llm_
     ggml_tensor * tok_embd = ggml_get_rows(ctx0, model.tok_embd, inp->tokens);
     cb(tok_embd, "mtp_tok_embd", il);
 
-    ggml_tensor * h = inp->h;
+    ggml_tensor * h_state = ggml_reshape_3d(ctx0, inp->h, n_embd, hc, n_tokens);
+    cb(h_state, "mtp_h_state", il);
+
     res->add_input(std::move(inp));
 
     ggml_tensor * inp_pos     = build_inp_pos();
@@ -322,9 +324,11 @@ llama_model_qwen4exp::graph_mtp::graph_mtp(const llama_model & model, const llm_
     // plain attention input. create_memory gives that context an attention-only filter.
     auto        * inp_attn    = build_attn_inp_kv();
 
-    // the reference norms the whole hyper-connection row and splits into streams after,
-    // so hnorm spans hc*n_embd rather than one stream
-    ggml_tensor * h_norm = build_norm(h, layer.nextn.hnorm, nullptr, LLM_NORM_RMS, il);
+    // Grouped RMSNorm reduces each hyper-connection stream independently, as the trunk does.
+    // The stored gamma still spans the flattened hc*n_embd row.
+    ggml_tensor * h_norm = ggml_rms_norm(ctx0, h_state, hparams.f_norm_rms_eps);
+    h_norm = ggml_reshape_2d(ctx0, h_norm, hc*n_embd, n_tokens);
+    h_norm = ggml_mul(ctx0, h_norm, layer.nextn.hnorm);
     h_norm = ggml_reshape_3d(ctx0, h_norm, n_embd, hc, n_tokens);
     cb(h_norm, "mtp_hnorm", il);
 
@@ -360,20 +364,22 @@ llama_model_qwen4exp::graph_mtp::graph_mtp(const llama_model & model, const llm_
     inpL = build_hc_combine(inpL, cur, inject, il);
     cb(inpL, "mtp_l_out", il);
 
-    ggml_tensor * flat = ggml_reshape_2d(ctx0, inpL, hc*n_embd, n_tokens);
-
-    // a chained head reads the streams back the way the trunk hands them over
-    res->t_h_nextn = flat;
+    // Export the materialized wide residual. A reshape-only view does not have a stable
+    // backend assignment for the nextn readback path.
+    cb(inpL, "h_nextn", -1);
+    res->t_h_nextn = inpL;
 
     if (inp_out_ids) {
+        ggml_tensor * flat = ggml_reshape_2d(ctx0, inpL, hc*n_embd, n_tokens);
         flat = ggml_get_rows(ctx0, flat, inp_out_ids);
         inpL = ggml_reshape_3d(ctx0, flat, n_embd, hc, n_outputs);
     }
 
     cur = build_hc_mix(inpL, model.hc_head_norm, model.hc_head_down, model.hc_head_up, nullptr, nullptr, -1);
     cb(cur, "result_norm", -1);
-    res->t_embd = cur;
 
+    // Do not publish t_embd here. The MTP context sizes its nextn buffer for the wide
+    // hc*n_embd state, while this tensor is only n_embd wide.
     cur = build_lora_mm(model.output, cur, model.output_s);
     cb(cur, "result_output", -1);
     res->t_logits = cur;
@@ -546,17 +552,17 @@ llama_model_qwen4exp::graph::graph(const llama_model & model, const llm_graph_pa
         cb(res_hc, "l_last", il);
     }
 
-    // Hand the wide residual to an MTP head, before the final mix collapses it. The draft
-    // reads all hc streams, which is what its hnorm is sized for. res_hc is passed as is
-    // rather than reshaped: a bare view is not a node the scheduler places, and the
-    // extraction is a flat copy, for which [n_embd, hc, T] and [hc*n_embd, T] are identical.
-    res->t_h_nextn = res_hc;
-
-    // deferred output masking for the unmasked-nextn case above
-    if (inp_out_ids && !mask_early) {
-        res_hc = ggml_reshape_2d(ctx0, res_hc, n_embd*hc, res_hc->ne[2]);
-        res_hc = ggml_get_rows(ctx0, res_hc, inp_out_ids);
-        res_hc = ggml_reshape_3d(ctx0, res_hc, n_embd, hc, res_hc->ne[1]);
+    // Hand the materialized wide residual to an MTP head before the final mix collapses it.
+    if (cparams.embeddings_nextn) {
+        cb(res_hc, "h_nextn", -1);
+        res->t_h_nextn = res_hc;
+
+        // Deferred output masking for the unmasked-nextn case above.
+        if (inp_out_ids && !mask_early) {
+            res_hc = ggml_reshape_2d(ctx0, res_hc, n_embd*hc, res_hc->ne[2]);
+            res_hc = ggml_get_rows(ctx0, res_hc, inp_out_ids);
+            res_hc = ggml_reshape_3d(ctx0, res_hc, n_embd, hc, res_hc->ne[1]);
+        }
     }
 
     // the final mixer is the output norm: there is no separate one
-- 
2.55.0

